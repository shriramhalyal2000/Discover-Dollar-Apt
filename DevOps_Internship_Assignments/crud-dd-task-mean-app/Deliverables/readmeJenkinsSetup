##  docker-compose.yml (on EC2)

yaml
version: "3.8"

services:
  mongo:
    image: mongo:6-jammy
    container_name: mongo
    restart: unless-stopped
    environment:
      MONGO_INITDB_DATABASE: tutorials_db
    volumes:
      - mongo_data:/data/db
    networks:
      - app-network

  backend:
    image: shriram2105/mean-backend:${TAG}
    container_name: backend
    restart: unless-stopped
    depends_on:
      - mongo
    environment:
      DB_URL: mongodb://mongo:27017/tutorials_db
      PORT: 8080
    networks:
      - app-network
    ports:
      - "8082:8080"

  frontend:
    image: shriram2105/mean-frontend:${TAG}
    container_name: frontend
    restart: unless-stopped
    depends_on:
      - backend
    networks:
      - app-network
    ports:
      - "80:4200"

networks:
  app-network:
    driver: bridge

volumes:
  mongo_data:
```

